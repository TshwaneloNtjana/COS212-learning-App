  {
    "id": "lesson-bst",
    "title": "Lesson 2 practice quiz",
    "description": "The BST rule, search and insert.",
    "lessonSlug": "bst",
    "kind": "practice",
    "passMark": 70,
    "questions": [
      {
        "id": "b1",
        "type": "mcq",
        "prompt": "A BST's root holds 50. Where must the value 45 be?",
        "options": [
          {
            "id": "a",
            "text": "Somewhere in the left subtree"
          },
          {
            "id": "b",
            "text": "Somewhere in the right subtree"
          },
          {
            "id": "c",
            "text": "Either subtree"
          }
        ],
        "answer": "a",
        "explanation": "45 < 50, and the BST rule puts every smaller value in the left subtree."
      },
      {
        "id": "b2",
        "type": "mcq",
        "prompt": "You insert 35 into this BST. Where does it go?",
        "tree": [
          50,
          30,
          70,
          20,
          40,
          60,
          80
        ],
        "options": [
          {
            "id": "a",
            "text": "Right child of 30"
          },
          {
            "id": "b",
            "text": "Left child of 40"
          },
          {
            "id": "c",
            "text": "Right child of 40"
          }
        ],
        "answer": "b",
        "explanation": "35 < 50 → left; 35 > 30 → right; 35 < 40 → left. 40 has no left child, so 35 goes there."
      },
      {
        "id": "b3",
        "type": "mcq",
        "prompt": "How many comparisons does it take to find 60 in this BST?",
        "tree": [
          50,
          30,
          70,
          20,
          40,
          60,
          80
        ],
        "options": [
          {
            "id": "a",
            "text": "2"
          },
          {
            "id": "b",
            "text": "3"
          },
          {
            "id": "c",
            "text": "4"
          }
        ],
        "answer": "b",
        "explanation": "60 is compared with 50, then 70, then 60: three comparisons."
      },
      {
        "id": "b4",
        "type": "mcq",
        "prompt": "You insert 10, 20, 30, 40 into an empty BST, in that order. What do you get?",
        "options": [
          {
            "id": "a",
            "text": "A balanced tree"
          },
          {
            "id": "b",
            "text": "A lopsided chain, so search becomes O(n)"
          },
          {
            "id": "c",
            "text": "An invalid BST"
          }
        ],
        "answer": "b",
        "explanation": "Each value is larger than the last, so every node goes to the right. The tree becomes a chain."
      }
    ]
  },
