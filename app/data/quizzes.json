  {
    "id": "warmup",
    "title": "Warm-up: queues and stacks",
    "description": "Check the queue ideas you'll need for BFS.",
    "lessonSlug": null,
    "kind": "warmup",
    "passMark": 70,
    "questions": [
      {
        "id": "w1",
        "type": "mcq",
        "prompt": "A queue holds 4, 9 and 2. The 4 was added first. You remove one item. Which item comes out?",
        "options": [
          {
            "id": "a",
            "text": "4"
          },
          {
            "id": "b",
            "text": "9"
          },
          {
            "id": "c",
            "text": "2"
          }
        ],
        "answer": "a",
        "explanation": "A queue is first in, first out (FIFO), so 4, the first item added, leaves first."
      },
      {
        "id": "w2",
        "type": "mcq",
        "prompt": "You push 4, then 9, then 2 onto a stack. You pop one item. Which item comes out?",
        "options": [
          {
            "id": "a",
            "text": "4"
          },
          {
            "id": "b",
            "text": "9"
          },
          {
            "id": "c",
            "text": "2"
          }
        ],
        "answer": "c",
        "explanation": "A stack is last in, first out (LIFO), so 2, the last item pushed, comes out first."
      },
      {
        "id": "w3",
        "type": "mcq",
        "prompt": "Which structure is \"first in, first out\"?",
        "options": [
          {
            "id": "a",
            "text": "Stack"
          },
          {
            "id": "b",
            "text": "Queue"
          },
          {
            "id": "c",
            "text": "Both"
          }
        ],
        "answer": "b",
        "explanation": "A queue is FIFO. A stack is LIFO."
      },
      {
        "id": "w4",
        "type": "mcq",
        "prompt": "In a queue, where does a new item join?",
        "options": [
          {
            "id": "a",
            "text": "At the front"
          },
          {
            "id": "b",
            "text": "At the back"
          },
          {
            "id": "c",
            "text": "In sorted position"
          }
        ],
        "answer": "b",
        "explanation": "New items join at the back of a queue (enqueue) and leave from the front (dequeue)."
      }
    ]
  },
